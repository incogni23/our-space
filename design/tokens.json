  "font": {
    "family": {
      "serif": "'Newsreader', 'Iowan Old Style', Georgia, serif",
      "sans": "'DM Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'DM Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace"
    },
    "style": {
      "display-xl": { "family": "serif", "size": { "mobile": 48, "desktop": 64 }, "weight": 400, "lineHeight": 1.0, "tracking": "-0.02em" },
      "display": { "family": "serif", "size": { "mobile": 34, "desktop": 44 }, "weight": 400, "lineHeight": 1.05, "tracking": "-0.015em" },
      "title-l": { "family": "serif", "size": { "mobile": 28, "desktop": 32 }, "weight": 400, "lineHeight": 1.1, "tracking": "-0.01em" },
      "title": { "family": "serif", "size": { "mobile": 22, "desktop": 26 }, "weight": 400, "lineHeight": 1.2, "tracking": "0" },
      "note": { "family": "serif", "style": "italic", "size": { "mobile": 15, "desktop": 19 }, "weight": 400, "lineHeight": 1.4, "tracking": "0" },
      "body-l": { "family": "sans", "size": { "mobile": 17, "desktop": 17 }, "weight": 400, "lineHeight": 1.55, "tracking": "0" },
      "body": { "family": "sans", "size": { "mobile": 15, "desktop": 15 }, "weight": 400, "lineHeight": 1.5, "tracking": "0" },
      "input": { "family": "sans", "size": { "mobile": 16, "desktop": 16 }, "weight": 400, "lineHeight": 1.4, "tracking": "0" },
      "label": { "family": "sans", "size": { "mobile": 13, "desktop": 13 }, "weight": 500, "lineHeight": 1.35, "tracking": "0" },
      "caption": { "family": "sans", "size": { "mobile": 12, "desktop": 12 }, "weight": 400, "lineHeight": 1.4, "tracking": "0" },
      "stamp": { "family": "mono", "size": { "mobile": 11, "desktop": 11 }, "weight": 500, "lineHeight": 1.3, "tracking": "0.1em", "transform": "uppercase" }
    }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "14": 56, "18": 72, "24": 96 },
  "radius": { "print": 3, "note": 4, "control": 12, "pin": 12, "card": 14, "ticket": 18, "sheet": 22, "pill": 999 },
  "shadow": {
    "paper": "0 1px 0 rgba(68, 53, 62, 0.05), 0 8px 24px -12px rgba(68, 53, 62, 0.3)",
    "lift": "0 2px 4px rgba(68, 53, 62, 0.06), 0 18px 40px -16px rgba(68, 53, 62, 0.45)",
    "sheet": "0 -12px 40px rgba(46, 35, 41, 0.25)",
    "ring-new": "0 0 0 2px #C78382, 0 0 0 6px #F3E3DF"
  },
  "border": {
    "hairline": "1px solid line-subtle",
    "control": "1px solid line-control",
    "selected": "2px solid text-primary",
    "empty": "1.5px dashed line-control",
    "focus": "2px solid focus-ring, offset 2px"
  },
  "icon": { "sm": 16, "md": 20, "lg": 24, "stroke": 1.7, "grid": 24 },
  "target": { "min": 44 },
  "motion": {
    "duration": { "quick": 120, "base": 220, "gentle": 420, "reveal": 700, "breathe": 1600 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.7, 0.2, 1)",
      "settle": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": "transforms become 120ms opacity fades; breathing stops"
  },
  "layer": { "base": 0, "sticky": 10, "nav": 20, "sheet": 40, "dialog": 50, "toast": 60 },
  "breakpoint": { "xs": 360, "sm": 390, "md": 744, "lg": 1024, "xl": 1280, "2xl": 1536 },
  "layout": { "contentMax": 1120, "sidebar": 264, "gutter": { "sm": 16, "md": 24, "lg": 48 } }
}
