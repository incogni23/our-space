# Between Us API. Build from the repo root: docker build -f Dockerfile.api -t betweenus-api .
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY db ./db
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./api/cmd/api

# No shell, no package manager, runs as non-root.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /api
ENV ADDR=:8080 APP_ENV=production MIGRATE_ON_START=true
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/api"]
